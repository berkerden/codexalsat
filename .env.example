# Docker/PostgreSQL local development only. Do not use these values in a shared environment.
POSTGRES_DB=spotlab
POSTGRES_USER=spotlab
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432

# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=postgresql+psycopg://spotlab:change-this-local-password@db:5432/spotlab
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Safety interlock: must remain false until the controlled live-trading stage.
LIVE_TRADING_ENABLED=false

# Exchange credentials are intentionally absent. When later required, keep them
# in a backend-only secret store and grant no withdrawal permission.
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
